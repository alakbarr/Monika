{
  "include": [
    "src",
    "trading-agent/risk",
    "trading-agent/execution",
    "trading-agent/database"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/venv",
    "trading-agent/venv",
    "trading-agent/logs",
    "trading-agent/data",
    "trading-agent/logging_observability/dashboard/frontend",
    "src/monika/domain/indicators",
    "**/site-packages",
    "**/dist",
    ".git"
  ],
  "stubPath": "typings",
  "venvPath": "trading-agent",
  "venv": "venv",
  "extraPaths": ["src", "trading-agent", "."],
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": false,
  "reportMissingImports": false,
  "reportMissingModuleSource": false
}
