{
  "include": [
    "src"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/venv",
    "venv",
    ".venv",
    "logs",
    "data",
    "frontend",
    "**/site-packages",
    "**/dist",
    ".git"
  ],
  "stubPath": "typings",
  "venvPath": ".",
  "venv": "venv",
  "extraPaths": ["src"],
  "typeCheckingMode": "standard",
  "reportMissingTypeStubs": false,
  "reportMissingImports": false,
  "reportMissingModuleSource": false
}
