[importlinter]
root_package = monika

[importlinter:contract:1]
name = Core Layer Boundary
type = forbidden
source_modules =
    monika.core
forbidden_modules =
    monika.interfaces

[importlinter:contract:2]
name = Domain Layer Boundary
type = forbidden
source_modules =
    monika.domain
forbidden_modules =
    monika.interfaces
    monika.application
    monika.infrastructure

[importlinter:contract:3]
name = Application Layer Boundary
type = forbidden
source_modules =
    monika.application
forbidden_modules =
    monika.interfaces
