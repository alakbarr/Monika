[Unit]
Description=Monika MT5 Trading Agent Core Daemon
Documentation=https://github.com/alakbarr/Monika
After=network.target network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=tradeagent
Group=tradeagent
WorkingDirectory=/opt/Monika/trading-agent
Environment="PYTHONPATH=/opt/Monika/trading-agent"
Environment="PYTHONUNBUFFERED=1"
Environment="DASHBOARD_HOST=127.0.0.1"
Environment="DASHBOARD_PORT=8000"
EnvironmentFile=-/opt/Monika/.env
ExecStart=/opt/Monika/trading-agent/venv/bin/python -m main --dry-run
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=15s
TimeoutStopSec=30s

# Process and file descriptor limits
LimitNOFILE=65536
LimitNPROC=4096

# Security hardening directives
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

# Logging via systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=monika

[Install]
WantedBy=multi-user.target
