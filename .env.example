# ==============================================================================
# Monika: Autonomous MT5 Quantitative Trading Agent — Environment Configuration
# ==============================================================================
# Instructions:
# 1. This file can be configured automatically via the wizard: start_monika.bat / .sh
# 2. Or manually copy to .env: `cp .env.example .env` and populate the values below.
# 3. DO NOT commit your private .env file to public version control repositories!
# ==============================================================================

# ==============================================================================
# 1. CORE CONFIGURATION (REQUIRED FOR ALL TIERS / TRIAL & FULL)
# ==============================================================================

# Database Connection URL:
# - Trial Package: Use the zero-config SQLite default below (no database server required)
# - Full Package:  postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite+aiosqlite:///data/monika.db

# MetaTrader 5 Terminal Credentials (Required for live candlestick & spread data):
# - Open MT5 -> File -> Open an Account -> select MetaQuotes-Demo for a free virtual account
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_demo_or_real_password
MT5_SERVER=MetaQuotes-Demo
# Leave MT5_PATH blank for automatic terminal64.exe detection
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Telegram Bot Interface & Mobile Oversight (Required for alerts & trade proposals):
# - Bot Token: Create a bot in Telegram via @BotFather (send /newbot)
# - Chat ID:   Message @userinfobot (send /start) to retrieve your numeric user ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=987654321
# Optional comma-separated whitelist of additional allowed user chat IDs:
# TELEGRAM_ALLOWED_USERS=987654321

# Primary AI Model API Key (At least one provider required):
# - Google Gemini Free Tier (Recommended, zero-cost, no credit card required):
#   Register at: https://aistudio.google.com/apikey
#   Separate multiple keys with commas for automatic failover quota rotation.
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 2. OPTIONAL AI PROVIDERS & MULTI-MODEL ROTATION
# ==============================================================================

# OpenRouter (Unified multi-model gateway): https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq Cloud (Ultra-fast Llama-3 inference): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude (Claude 3.5 Sonnet / Haiku): https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4o / GPT-4o-mini): https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek (DeepSeek-V3 / R1): https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==============================================================================
# 3. MACROECONOMIC DATA & WEB SEARCH GROUNDING (OPTIONAL)
# ==============================================================================

# Federal Reserve Economic Data (FRED): https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key_here

# Finnhub Financial API: https://finnhub.io/
# FINNHUB_API_KEY=your_finnhub_api_key_here

# US Energy Information Administration (EIA) - Crude oil inventories: https://www.eia.gov/opendata/
# EIA_API_KEY=your_eia_api_key_here

# Tavily Search API (Breaking news grounding): https://tavily.com/
# TAVILY_API_KEY=your_tavily_api_key_here

# Hugging Face Access Token (Google TimesFM 3.0 model weights download): https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

# ==============================================================================
# 4. OBSERVABILITY DASHBOARD & API SECURITY (FULL PACKAGE)
# ==============================================================================

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_DISABLE_DOCS=false

# Web Dashboard authentication tokens:
DASHBOARD_SECRET=your_dashboard_admin_secret_token
DASHBOARD_API_KEY=your_dashboard_admin_secret_token

# ==============================================================================
# 5. REMOTE EXECUTION GATEWAY & VPS BRIDGE (OPTIONAL)
# ==============================================================================
# Used when running the Monika agent core on Linux/Cloud and connecting to a
# remote Windows VPS running the MT5 Terminal + Execution Gateway.
# EXECUTION_SERVICE_URL=http://127.0.0.1:8080
# EXECUTION_SERVICE_AUTH_TOKEN=your_remote_gateway_auth_token
