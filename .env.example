# ==============================================================================
# Monika: Autonomous MT5 Quantitative Trading Agent — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g. `cp .env.example .env`)
# 2. Populate your private API keys and broker credentials.
# 3. DO NOT commit your completed .env file to public version control!
# ==============================================================================

# ==============================================================================
# 1. CORE PERSISTENCE & BROKER EXECUTION (REQUIRED)
# ==============================================================================

# PostgreSQL database connection string (asyncpg driver required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://monika_user:your_secure_password@localhost:5432/monika_trading

# MetaTrader 5 Desktop Terminal Credentials
MT5_ACCOUNT=12345678
MT5_PASSWORD=your_mt5_broker_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Telegram Bot Interface & Remote Supervision
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=987654321
# Comma-separated whitelist of allowed user chat IDs (empty = admin only)
TELEGRAM_ALLOWED_USERS=987654321

# Primary Reasoning LLM (Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==============================================================================
# 2. MULTI-PROVIDER LLM FABRIC & ROTATION POOLS (RECOMMENDED)
# ==============================================================================

# Google Gemini API
# Free Tier: Comma-separated list for automatic round-robin & quota rotation
GEMINI_API_KEYS=key1,key2,key3
# Single key fallback (if GEMINI_API_KEYS is not set)
GEMINI_API_KEY=your_gemini_api_key_here
# Paid Tier: Dedicated key for high-priority / unthrottled inference tasks
GEMINI_PAID_API_KEY=your_gemini_paid_api_key_here

# OpenAI API (GPT-4o, o1, etc.)
OPENAI_API_KEY=your_openai_api_key_here
# Comma-separated rotation pool (optional)
# OPENAI_API_KEYS=key1,key2

# DeepSeek API (DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Comma-separated rotation pool (optional)
# DEEPSEEK_API_KEYS=key1,key2

# Groq Cloud API (High-speed inference for Llama-3 / Mixtral)
# Free Tier: Comma-separated list for rate-limit rotation
GROQ_API_KEYS=key1,key2,key3
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API (Unified multi-model gateway)
# Comma-separated rotation keys
OPENROUTER_API_KEYS=key1,key2
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Dedicated paid account key for priority routing
OPENROUTER_PAID_API_KEY=your_openrouter_paid_api_key_here

# TypeSafe API
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ==============================================================================
# 3. MACROECONOMIC, FINANCIAL DATA & SEARCH APIS
# ==============================================================================

# Federal Reserve Economic Data (FRED) — US Treasury yields, inflation, Fed Funds
FRED_API_KEY=your_fred_api_key_here

# Finnhub Financial API — Economic calendar fallback & market sentiment
FINNHUB_API_KEY=your_finnhub_api_key_here

# U.S. Energy Information Administration (EIA) — Weekly crude oil inventory (XTIUSD/XBRUSD)
EIA_API_KEY=your_eia_api_key_here

# Web Search Grounding for Breaking News Intelligence
# Tavily Search API (comma-separated rotation pool or single key)
TAVILY_API_KEYS=tvly-key1,tvly-key2
TAVILY_API_KEY=your_tavily_api_key_here

# Brave Search API (alternative search provider)
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Hugging Face Access Token (used for automatic Google TimesFM 3.0 model weights download)
HF_TOKEN=your_huggingface_token_here

# ==============================================================================
# 4. OBSERVABILITY DASHBOARD & API SECURITY
# ==============================================================================

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DASHBOARD_DISABLE_DOCS=false

# Dashboard Authentication Secret / API Key
# Maps to Role.ADMIN for REST endpoints and WebSocket authentication
DASHBOARD_SECRET=your_dashboard_admin_secret_token
DASHBOARD_API_KEY=your_dashboard_admin_secret_token

# Role-Based Access Control (RBAC) multi-key mapping (optional)
# Format: role:key,role:key (roles: admin, operator, viewer)
# DASHBOARD_API_KEYS=admin:sk-admin-123,operator:sk-ops-456,viewer:sk-view-789

# IP Whitelisting & CORS (optional)
# DASHBOARD_ALLOWED_IPS=127.0.0.1,192.168.1.50
# DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# 5. REMOTE EXECUTION GATEWAY & VPS BRIDGE (OPTIONAL)
# ==============================================================================
# Used when running Monika agent core on Linux/Cloud and connecting to a
# remote Windows VPS running the MT5 Terminal + Execution Gateway.

EXECUTION_SERVICE_URL=http://127.0.0.1:8080
EXECUTION_SERVICE_AUTH_TOKEN=your_remote_gateway_auth_token
# Aliases supported by remote gateway adapter:
# MT5_GATEWAY_URL=http://127.0.0.1:8080
# MT5_GATEWAY_TOKEN=your_remote_gateway_auth_token

# MT5 EA Bridge Common Files Directory (for heartbeat & dead-man switch)
# Windows default: %APPDATA%\MetaQuotes\Terminal\Common\Files
# MT5_COMMON_FILES_PATH=C:/Users/Administrator/AppData/Roaming/MetaQuotes/Terminal/Common/Files

# Logging Directory
# LOG_DIR=logs
