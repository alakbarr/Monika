# ==============================================================================
# Monika: Autonomous MT5 Quantitative Trading Agent — Environment Configuration
# ==============================================================================
# Instructions:
# 1. This file can be configured automatically via the wizard: start_monika.bat / .sh
# 2. Or manually copy to .env: `cp .env.example .env` and populate the values below.
# 3. DO NOT commit your private .env file to public version control repositories!
# ==============================================================================

# ==============================================================================
# 1. CORE CONFIGURATION (REQUIRED FOR ALL TIERS / TRIAL & FULL)
# ==============================================================================

# Operating Tier and Environment:
ENVIRONMENT=production
# MONIKA_TIER: 'trial' (lightweight SQLite) or 'full' (institutional PostgreSQL)
MONIKA_TIER=full
# PAPER_TRADING_MODE: true (default paper-trading simulation) or false (live broker)
PAPER_TRADING_MODE=true

# Canonical user data directory (defaults to %LOCALAPPDATA%\Monika on Windows, ~/.local/share/monika on Linux):
# MONIKA_HOME=

# Custom settings.yaml path override:
# SETTINGS_PATH=config/settings.yaml

# Database Connection URL:
# - Trial Package: Use the zero-config SQLite default below (no database server required)
# - Full Package:  postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=sqlite+aiosqlite:///data/monika.db
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# MetaTrader 5 Terminal Credentials (Required for live candlestick & spread data):
# - Open MT5 -> File -> Open an Account -> select MetaQuotes-Demo for a free virtual account
MT5_ACCOUNT=12345678
# MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_demo_or_real_password
MT5_SERVER=MetaQuotes-Demo
# Leave MT5_PATH blank for automatic terminal64.exe detection
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# MT5_COMMON_FILES_PATH=C:/Users/username/AppData/Roaming/MetaQuotes/Terminal/Common/Files
# MT5_EXPECTED_TRADE_MODE=demo

# Telegram Bot Interface & Mobile Oversight (Required for alerts & trade proposals):
# - Bot Token: Create a bot in Telegram via @BotFather (send /newbot)
# - Chat ID:   Message @userinfobot (send /start) to retrieve your numeric user ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=987654321
# Optional comma-separated whitelist of additional allowed user chat IDs:
# TELEGRAM_ALLOWED_USERS=987654321

# Primary AI Model API Key (At least one provider required):
# - Google Gemini Free Tier (Recommended, zero-cost, no credit card required):
#   Register at: https://aistudio.google.com/apikey
#   Separate multiple keys with commas for automatic failover quota rotation.
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_PAID_API_KEY=
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ==============================================================================
# 2. OPTIONAL AI PROVIDERS & MULTI-MODEL ROTATION
# ==============================================================================

# OpenRouter (Unified multi-model gateway): https://openrouter.ai/keys
# - Paid Models (Claude Sonnet, GLM-5.3, GPT-4o, etc.):
# OPENROUTER_PAID_API_KEY=your_paid_key_here
# - Free Models (:free suffix, e.g. GLM-5.2:free, Nemotron:free - multiple comma-separated keys for rotation):
# OPENROUTER_API_KEYS=free_key_1,free_key_2
# - Legacy single key fallback:
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq Cloud (Ultra-fast Llama-3 inference): https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEYS=key1,key2

# Anthropic Claude (Claude 3.5 Sonnet / Haiku): https://console.anthropic.com/
# (Or use Claude Code subscription via: python -m monika.interfaces.cli.main auth login claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_API_KEYS=key1,key2
# CLAUDE_CONFIG_DIR=

# OpenAI (GPT-4o / GPT-4o-mini): https://platform.openai.com/api-keys
# (Or use ChatGPT Plus/Pro subscription via: python -m monika.interfaces.cli.main auth login codex)
# OPENAI_API_KEY=your_openai_api_key_here
# CODEX_ACCESS_TOKEN=
# CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# DeepSeek (DeepSeek-V3 / R1): https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Z.AI / GLM Coding Plan: https://z.ai/subscribe or https://open.bigmodel.cn/
# (Or authenticate via: python -m monika.interfaces.cli.main auth login zai)
# ZAI_API_KEY=your_zai_api_key_here
# GLM_API_KEY=your_zai_api_key_here
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Google Gemini Antigravity Bridge & Desktop OAuth:
# (Or authenticate via: python -m monika.interfaces.cli.main auth login antigravity)
# ANTIGRAVITY_PROXY_URL=http://127.0.0.1:8877/v1
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=

# OpenCode Go / Zen Subscription ($10/mo multi-model): https://opencode.ai
# (Or authenticate via: python -m monika.interfaces.cli.main auth login opencode)
# OPENCODE_API_KEY=your_opencode_api_key_here
# OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1

# NineRouter / Custom Gateway:
# NINEROUTER_API_KEY=
# NINEROUTER_KEY=
# NINEROUTER_BASE_URL=
# NINEROUTER_URL=

# TypeSafe SDK / Gateway:
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=

# ==============================================================================
# 3. MACROECONOMIC DATA & WEB SEARCH GROUNDING (OPTIONAL)
# ==============================================================================

# Federal Reserve Economic Data (FRED): https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key_here

# Finnhub Financial API: https://finnhub.io/
# FINNHUB_API_KEY=your_finnhub_api_key_here

# US Energy Information Administration (EIA) - Crude oil inventories: https://www.eia.gov/opendata/
# EIA_API_KEY=your_eia_api_key_here

# Tavily Search API (Breaking news grounding): https://tavily.com/
# TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_API_KEYS=key1,key2
# TRAVILY_API_KEYS=key1,key2

# Brave Search API: https://brave.com/search/api/
# BRAVE_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Scraper Headless / GUI Fallback:
# SCRAPER_ALLOW_GUI_FALLBACK=false

# Hugging Face Access Token (Google TimesFM 3.0 model weights download): https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

# Macro policy rate overrides:
# DEFAULT_FED_FUNDS_RATE=5.33
# FED_FUNDS_RATE=5.33
# POLICY_RATE_FED=5.33

# ==============================================================================
# 4. OBSERVABILITY DASHBOARD & API SECURITY (FULL PACKAGE)
# ==============================================================================

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
GUARDIAN_PORT=8001
DASHBOARD_DISABLE_DOCS=false
# DASHBOARD_URL=http://localhost:8000
# DASHBOARD_ALLOWED_IPS=127.0.0.1,::1
# DASHBOARD_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# GATEWAY_ALLOWED_ORIGINS=http://localhost:8000

# Web Dashboard authentication tokens:
DASHBOARD_SECRET=your_dashboard_admin_secret_token
DASHBOARD_API_KEY=your_dashboard_admin_secret_token
# DASHBOARD_API_KEYS=key1,key2

# Cryptographic and Vault Secrets:
# MONIKA_VAULT_KEY=your_32_byte_base64_encoded_vault_key
# MONIKA_ORDER_SIGNING_SECRET=your_order_signing_hmac_secret
# MONIKA_WRITE_SAFE_ROOT=D:/Monika/user_scripts

# ==============================================================================
# 5. REMOTE EXECUTION GATEWAY & VPS BRIDGE (OPTIONAL)
# ==============================================================================
# Used when running the Monika agent core on Linux/Cloud and connecting to a
# remote Windows VPS running the MT5 Terminal + Execution Gateway.
# EXECUTION_ADAPTER=mt5
# EXECUTION_SERVICE_URL=http://127.0.0.1:8080
# EXECUTION_SERVICE_AUTH_TOKEN=your_remote_gateway_auth_token
# MT5_GATEWAY_URL=http://127.0.0.1:8080
# MT5_GATEWAY_TOKEN=your_remote_gateway_auth_token
# MT5_LINUX_HOST=127.0.0.1
# MT5_LINUX_PORT=18812

# Optional Redis Cache / PubSub:
# REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# 6. EXTERNAL NOTIFIERS & WORKSPACE INTEGRATIONS (OPTIONAL)
# ==============================================================================
# DISCORD_BOT_TOKEN=
# DISCORD_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
# OBSIDIAN_VAULT_PATH=
# EXCEL_JOURNAL_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_USER_EMAIL=
# TRADINGVIEW_PASSPHRASE=
# TRADINGVIEW_WATCHLIST_ID=
